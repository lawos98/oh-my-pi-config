# Portable sources only. Review contents before publishing; tracked files bypass ignores.
/*
!/.gitignore
!/README.md
!/THIRD_PARTY_NOTICES.md
!/docs/
/docs/*
!/docs/*.md
!/bin/
/bin/*
!/bin/ohMyPi.mjs
!/bin/README.md
!/profiles/
/profiles/*
!/profiles/profiles.yml
!/profiles/README.md

!/agent/
/agent/*
!/agent/README.md
!/agent/config.yml
!/agent/RULES.md
!/agent/coding-rules.md
!/agent/response-rules-reminder.md
!/agent/commands/
/agent/commands/*
!/agent/commands/pr-review.md
!/agent/commands/pr-comments.md
!/agent/commands/simplify-code.md
!/agent/commands/learn.md
!/agent/commands/developer-docs.md
!/agent/commands/arena.md
!/agent/skills/
!/agent/skills/**
!/agent/managed-skills/
/agent/managed-skills/*
!/agent/managed-skills/README.md
!/agent/managed-skills/service-documentation/
!/agent/managed-skills/service-documentation/**

!/plugins/
/plugins/*
!/plugins/package.json
!/plugins/bun.lock
!/plugins/omp-plugins.lock.json
!/plugins/ponytail.json
!/plugins/README.md
!/plugins/reviewed-sources/
/plugins/reviewed-sources/*
!/plugins/reviewed-sources/.omp-plugin/
/plugins/reviewed-sources/.omp-plugin/*
!/plugins/reviewed-sources/.omp-plugin/marketplace.json

**/node_modules/
**/__pycache__/
**/.pytest_cache/
**/.DS_Store
**/.env
**/.env.*
**/auth.json
**/credentials.json
**/mcp.json
**/.mcp.json
**/*.key
**/*.pem
**/*.p12
**/*.db
**/*.db-shm
**/*.db-wal
**/*.log
**/.codex/
**/codex-home/
**/setup-backups/
**/sessions/
**/memories/
**/cache/
**/.hyperframes/
/agent/skills/hyperframes/runtime/state/
/agent/skills/jira-ticket-creator/

# The one reviewed, public GitNexus example; never copy local MCP credentials here.
!/agent/mcp.json
