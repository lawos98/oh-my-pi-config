# Deny by default. This repository is an explicit OMP configuration allowlist.
/*

!/.gitignore
!/README.md
!/THIRD_PARTY_NOTICES.md

!/agent/
/agent/*
!/agent/config.yml
!/agent/RULES.md
!/agent/coding-rules.md
!/agent/response-rules-reminder.md
!/agent/mcp.json

!/agent/commands/
/agent/commands/*
!/agent/commands/create-skill.md
!/agent/commands/pr-review.md
!/agent/commands/self-review.md
!/agent/commands/simplify-code.md

!/agent/skills/
/agent/skills/*
!/agent/skills/*/
/agent/skills/*/*
!/agent/skills/*/SKILL.md

!/agent/managed-skills/
/agent/managed-skills/*
!/agent/managed-skills/*/
/agent/managed-skills/*/*
!/agent/managed-skills/*/SKILL.md
