  "local_changes": [
    "SKILL.md and README.md: exclusive design authority, approval/data boundaries, no automatic verification loop",
    "scripts/lib/security.mjs: selected-project descriptor-relative no-follow reads and atomic staged output; public HTTPS/443 IPv4 DNS socket policy; redirect and streamed body bounds",
    "scripts/assets.mjs: all requests use public network policy; images 25 MiB, posters 10 MiB, API JSON 20 MiB; video cap retained, atomic streaming output and credits",
    "scripts/inspect.mjs: selected-root no-follow serving, Host and dot-path denial; safe screenshot/report outputs and old screenshot cleanup",
    "scripts/lib/cdp.mjs: executable presence/permission checks, fresh profile, explicit loopback CDP, startup cleanup, safe screenshot writes",
    "scripts/draw.mjs: project-only history and safe writes/reads of direction and history",
    "scripts/lint.mjs: project containment and symlink-safe input reads; symlink traversal skipped",
    "tests/security.test.mjs: offline regression tests, not executed"
  ],
  "excluded": "Other upstream skills, marketplace/plugin registrations, repository gallery images and repo-level tests are outside the default skill subtree",
  "residual_risks": [
    "Browser pages execute scripts and may make network requests; fresh profile is not a network sandbox",
    "Public asset providers and source license claims are not independently guaranteed; inspect source rights before use",
    "IPv6-only, HTTP-only and compressed responses deliberately fail closed",
    "Directory descriptors prevent symlink redirection; hostile processes with the same OS account can still rename directories, change ordinary files, or interfere with browser processes",
