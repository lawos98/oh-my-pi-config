# INERT EXAMPLE: activate only after separate publication approval.
# Configure Pages to use GitHub Actions and protect the github-pages environment.
# Review docs-site/zensical.toml site_url for the actual root or repository subpath.
# Build only trusted Markdown, HTML, configuration, and the reviewed requirements.lock.
name: Publish approved documentation

on:
  workflow_dispatch:

permissions: {}

concurrency:
  group: documentation-pages
  cancel-in-progress: false

jobs:
  build:
    # Do not build an arbitrary dispatch branch with publication credentials.
    if: github.ref == format('refs/heads/{0}', github.event.repository.default_branch)
    runs-on: ubuntu-latest
    permissions:
      contents: read
    defaults:
      run:
        working-directory: docs-site
    steps:
      - name: Check out approved source
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - name: Set up Python
        uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5
        with:
          python-version: '3.14'
      - name: Install reviewed locked dependencies in isolation
        run: |
          python -m venv .venv
          .venv/bin/python -m pip install --disable-pip-version-check --require-hashes --only-binary=:all: -r requirements.lock
      - name: Build static documentation
        run: .venv/bin/zensical build
      - name: Upload only generated site
        uses: actions/upload-pages-artifact@56afc609e74202658d3ffba0e8f6dda462b719fa # v3
        with:
          path: docs-site/site
          retention-days: 1

  deploy:
    needs: build
    runs-on: ubuntu-latest
    permissions:
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Deploy approved artifact
        id: deployment
        uses: actions/deploy-pages@d6db90164ac5ed86f2b6aed7e0febac5b3c0c03e # v4
